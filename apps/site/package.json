{
  "name": "@rind-ui/site",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/content.ts",
    "predev": "node scripts/content.ts",
    "dev": "node --watch-path=examples --watch-path=skins --watch-path=content/pages --watch-path=../../docs scripts/content.ts & next dev -p 3300",
    "build": "node scripts/content.ts && next build",
    "typecheck": "node scripts/content.ts && tsc --noEmit",
    "audit": "node scripts/content.ts && next build && node tests/audit.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@rind-ui/core": "workspace:*",
    "@rind-ui/react": "workspace:*",
    "@rind-ui/theme": "workspace:*",
    "highlight.js": "11.12.0",
    "lenis": "1.3.26",
    "marked": "18.0.14",
    "next": "15.5.27",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.13.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
