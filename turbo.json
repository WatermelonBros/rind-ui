{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["tokens.manifest.json", "src/builder/components.generated.ts"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "storybook-static/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "//#test:vitest": {
      "dependsOn": [
        "@rind-ui/storybook#build",
        "@rind-ui/testing#build",
        "@rind-ui/theme#generate"
      ],
      "env": ["RIND_BROWSERS", "RIND_MAX_WORKERS"],
      "outputs": []
    }
  }
}
