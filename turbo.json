{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#test:vitest": {
      "dependsOn": ["@rind-ui/storybook#build", "@rind-ui/testing#build"],
      "env": ["RIND_BROWSERS", "RIND_MAX_WORKERS"],
      "outputs": []
    }
  }
}
