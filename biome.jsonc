{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Stories never have declaration files: ignore any a misconfigured build writes there.
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!openspec",
      "!.claude",
      "!.reado",
      "!apps/storybook/stories/**/*.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100, "lineEnding": "lf" },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        // tsconfig's noPropertyAccessFromIndexSignature requires obj["key"] for index
        // signatures; this rule demands the opposite. The compiler wins.
        "useLiteralKeys": "off"
      }
    }
  }
}
