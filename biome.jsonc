{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Stories never have declaration files: ignore any a misconfigured build writes there.
    "includes": [
      "**",
      "!**/dist",
      "!openspec",
      "!.claude",
      "!.reado",
      // Generated by the theme builder (byte-identical output is tested).
      "!packages/theme/src/presets/*.css"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100, "lineEnding": "lf" },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        // tsconfig's noPropertyAccessFromIndexSignature requires obj["key"] for index
        // signatures; this rule demands the opposite. The compiler wins.
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // React's rules of hooks: Vue composables and Svelte rune helpers are named `use*` but
      // run in setup / component initialisation, where these rules do not apply.
      "includes": ["packages/vue/**", "packages/svelte/**"],
      "linter": { "rules": { "correctness": { "useHookAtTopLevel": "off" } } }
    },
    {
      // The copyable examples are named after the site's React exports (Basic, Controlled):
      // a page's example, not a reusable component.
      "includes": ["packages/vue/examples/**"],
      "linter": { "rules": { "style": { "useVueMultiWordComponentNames": "off" } } }
    },
    {
      // Biome reads a component's <script> only: what the template uses looks unused.
      "includes": ["**/*.svelte", "**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useConst": "off", "useImportType": "off" }
        }
      }
    }
  ]
}
