{
  "name": "rind-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test:vitest",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/lint-platform.mjs && node scripts/lint-test-delays.mjs && node scripts/lint-generated.mjs",
    "format": "biome check --write .",
    "changeset": "changeset",
    "test:vitest": "vitest run",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "quirks:check": "node scripts/quirks-check.ts",
    "docs:gen": "node scripts/docs-gen.ts",
    "docs:check": "node scripts/docs-gen.ts --check",
    "regen": "pnpm --filter @rind-ui/theme presets && node scripts/docs-gen.ts",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@guidepup/guidepup": "^0.35.0",
    "@guidepup/playwright": "^0.19.1",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.7",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
