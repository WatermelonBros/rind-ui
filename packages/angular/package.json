{
  "name": "@rind-ui/angular",
  "version": "1.1.0",
  "private": true,
  "description": "Accessible headless Angular directives: behaviour, keyboard, ARIA and state, styled through data-* attributes. Every component ships a test driver.",
  "license": "MIT",
  "author": "Watermelon Bros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatermelonBros/rind-ui.git",
    "directory": "packages/angular"
  },
  "homepage": "https://rind.watermelon-studio.it",
  "bugs": {
    "url": "https://github.com/WatermelonBros/rind-ui/issues"
  },
  "keywords": [
    "angular",
    "signals",
    "headless",
    "headless-ui",
    "directives",
    "accessibility",
    "a11y",
    "wai-aria",
    "state-machine",
    "design-system",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@rind-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./badge": {
      "@rind-ui/source": "./src/badge/index.ts",
      "types": "./dist/badge/index.d.ts",
      "default": "./dist/badge/index.js"
    },
    "./button": {
      "@rind-ui/source": "./src/button/index.ts",
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./heading": {
      "@rind-ui/source": "./src/heading/index.ts",
      "types": "./dist/heading/index.d.ts",
      "default": "./dist/heading/index.js"
    },
    "./kbd": {
      "@rind-ui/source": "./src/kbd/index.ts",
      "types": "./dist/kbd/index.d.ts",
      "default": "./dist/kbd/index.js"
    },
    "./label": {
      "@rind-ui/source": "./src/label/index.ts",
      "types": "./dist/label/index.d.ts",
      "default": "./dist/label/index.js"
    },
    "./link": {
      "@rind-ui/source": "./src/link/index.ts",
      "types": "./dist/link/index.d.ts",
      "default": "./dist/link/index.js"
    },
    "./separator": {
      "@rind-ui/source": "./src/separator/index.ts",
      "types": "./dist/separator/index.d.ts",
      "default": "./dist/separator/index.js"
    },
    "./toggle": {
      "@rind-ui/source": "./src/toggle/index.ts",
      "types": "./dist/toggle/index.d.ts",
      "default": "./dist/toggle/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "ngc -p tsconfig.json"
  },
  "dependencies": {
    "@rind-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@rind-ui/react": "workspace:*",
    "@rind-ui/testing": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@angular/common": ">=21",
    "@angular/core": ">=21"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./badge": {
        "types": "./dist/badge/index.d.ts",
        "default": "./dist/badge/index.js"
      },
      "./button": {
        "types": "./dist/button/index.d.ts",
        "default": "./dist/button/index.js"
      },
      "./heading": {
        "types": "./dist/heading/index.d.ts",
        "default": "./dist/heading/index.js"
      },
      "./kbd": {
        "types": "./dist/kbd/index.d.ts",
        "default": "./dist/kbd/index.js"
      },
      "./label": {
        "types": "./dist/label/index.d.ts",
        "default": "./dist/label/index.js"
      },
      "./link": {
        "types": "./dist/link/index.d.ts",
        "default": "./dist/link/index.js"
      },
      "./separator": {
        "types": "./dist/separator/index.d.ts",
        "default": "./dist/separator/index.js"
      },
      "./toggle": {
        "types": "./dist/toggle/index.d.ts",
        "default": "./dist/toggle/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
