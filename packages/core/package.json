{
  "name": "@rind-ui/core",
  "version": "0.2.0",
  "description": "Framework-agnostic state machines, DOM utilities and component contracts for rind-ui.",
  "license": "MIT",
  "author": "Watermelon Bros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatermelonBros/rind-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/WatermelonBros/rind-ui#readme",
  "bugs": {
    "url": "https://github.com/WatermelonBros/rind-ui/issues"
  },
  "keywords": [
    "headless",
    "state-machine",
    "accessibility",
    "a11y",
    "ui",
    "components"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@rind-ui/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./qr": {
      "@rind-ui/source": "./src/qr/index.ts",
      "types": "./dist/qr.d.mts",
      "default": "./dist/qr.mjs"
    },
    "./internal": {
      "@rind-ui/source": "./src/internal.ts",
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/size.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "dom-accessibility-api": "^0.7.1",
    "rolldown": "1.2.13"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/number": "^3.6.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
