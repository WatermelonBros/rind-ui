{
  "name": "@rind-ui/svelte",
  "version": "0.0.0",
  "description": "Accessible headless Svelte 5 components: behaviour, keyboard, ARIA and state, styled through data-* attributes. Every component ships a test driver.",
  "license": "MIT",
  "author": "Watermelon Bros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatermelonBros/rind-ui.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://rind.watermelon-studio.it",
  "bugs": {
    "url": "https://github.com/WatermelonBros/rind-ui/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "headless",
    "headless-ui",
    "components",
    "accessibility",
    "a11y",
    "wai-aria",
    "state-machine",
    "design-system",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@rind-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "@rind-ui/source": "./src/button/index.ts",
      "types": "./dist/button/index.d.ts",
      "svelte": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./toggle": {
      "@rind-ui/source": "./src/toggle/index.ts",
      "types": "./dist/toggle/index.d.ts",
      "svelte": "./dist/toggle/index.js",
      "default": "./dist/toggle/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && node ../../scripts/svelte-exports.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings"
  },
  "dependencies": {
    "@rind-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@rind-ui/testing": "workspace:*",
    "@sveltejs/package": "^3.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "rolldown": "1.2.13",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.0"
  },
  "peerDependencies": {
    "svelte": ">=5.29"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./button": {
        "types": "./dist/button/index.d.ts",
        "svelte": "./dist/button/index.js",
        "default": "./dist/button/index.js"
      },
      "./toggle": {
        "types": "./dist/toggle/index.d.ts",
        "svelte": "./dist/toggle/index.js",
        "default": "./dist/toggle/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
