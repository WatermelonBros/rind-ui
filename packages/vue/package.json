{
  "name": "@rind-ui/vue",
  "version": "0.0.0",
  "description": "Accessible headless Vue components: behaviour, keyboard, ARIA and state, styled through data-* attributes. Every component ships a test driver.",
  "license": "MIT",
  "author": "Watermelon Bros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatermelonBros/rind-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://rind.watermelon-studio.it",
  "bugs": {
    "url": "https://github.com/WatermelonBros/rind-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "headless",
    "headless-ui",
    "components",
    "accessibility",
    "a11y",
    "wai-aria",
    "state-machine",
    "design-system",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@rind-ui/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./button": {
      "@rind-ui/source": "./src/button/index.ts",
      "types": "./dist/button/index.d.mts",
      "default": "./dist/button/index.mjs"
    },
    "./toggle": {
      "@rind-ui/source": "./src/toggle/index.ts",
      "types": "./dist/toggle/index.d.mts",
      "default": "./dist/toggle/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rind-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@rind-ui/testing": "workspace:*",
    "@types/node": "^24.19.2",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./button": {
        "types": "./dist/button/index.d.mts",
        "default": "./dist/button/index.mjs"
      },
      "./toggle": {
        "types": "./dist/toggle/index.d.mts",
        "default": "./dist/toggle/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
