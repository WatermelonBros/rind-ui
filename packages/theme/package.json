{
  "name": "@rind-ui/theme",
  "version": "1.4.0",
  "description": "White-label theme for rind-ui: brand inputs, semantic tokens, variants and a typed theme builder, styled through data-scope / data-part attributes.",
  "license": "MIT",
  "author": "Watermelon Bros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatermelonBros/rind-ui.git",
    "directory": "packages/theme"
  },
  "homepage": "https://rind.watermelon-studio.it",
  "bugs": {
    "url": "https://github.com/WatermelonBros/rind-ui/issues"
  },
  "keywords": [
    "theme",
    "white-label",
    "design-tokens",
    "css",
    "oklch",
    "headless",
    "accessibility",
    "contrast"
  ],
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "!src/test-css.ts",
    "!src/vite-env.d.ts",
    "!src/builder/color-fixtures.json",
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./variants.css": "./src/variants.css",
    "./base.css": "./src/base.css",
    "./presets/*.css": "./src/presets/*.css",
    "./*.css": "./src/*.css",
    "./builder": {
      "@rind-ui/source": "./src/builder/index.ts",
      "types": "./dist/builder.d.mts",
      "default": "./dist/builder.mjs"
    }
  },
  "scripts": {
    "generate": "node scripts/token-manifest.mjs",
    "build": "tsdown && node scripts/build-presets.mjs --check",
    "presets": "node scripts/token-manifest.mjs && tsdown && node scripts/build-presets.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@types/node": "^24.19.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
